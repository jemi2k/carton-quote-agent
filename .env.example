# DeepSeek API (OpenAI-compatible). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Text model for field extraction (N2) and explanation (N6).
DEEPSEEK_MODEL=deepseek-chat
# Vision model for image OCR (N1). Must support image input (deepseek-flash).
DEEPSEEK_VISION_MODEL=deepseek-flash
